# Copy to .env.local for local development. On Vercel, set these in Project Settings > Environment Variables.

# Postgres connection string. Added automatically when you attach a Neon (Postgres) database in Vercel.
# Local Docker example: postgres://postgres:postgres@localhost:54329/reunion
DATABASE_URL=

# Vercel Blob token for a PRIVATE blob store. Added automatically when you attach the store in Vercel.
# Leave empty locally: photos are then saved to .data/uploads on disk.
BLOB_READ_WRITE_TOKEN=

# Long random string used to sign the login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# The only two accounts. "author" writes letters, "reader" opens them.
AUTHOR_USERNAME=
AUTHOR_PASSWORD=
READER_USERNAME=
READER_PASSWORD=
